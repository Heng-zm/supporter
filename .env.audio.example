# Secrets and identifiers only. Non-secret AUDIO_* values live in source_settings.py.
APP_ENVIRONMENT=production
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVICE_ROLE_OR_SERVER_SECRET

# Generate with: python scripts/generate_audio_key.py --version v1
AUDIO_ENCRYPTION_KEY_V1=BASE64_ENCODED_32_BYTE_KEY
# During rotation, keep old keys and add the new version before changing the
# active version in source_settings.py.
# AUDIO_ENCRYPTION_KEY_V2=BASE64_ENCODED_32_BYTE_KEY

TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_CHAT_ID=123456789
TELEGRAM_ADMIN_USER_IDS=123456789
TELEGRAM_WEBHOOK_SECRET=replace_with_url_safe_random_secret
TELEGRAM_WEBHOOK_URL=https://supporter-ipio.onrender.com/api/telegram/webhook
TELEGRAM_AUTO_CONFIGURE_WEBHOOK=true
TELEGRAM_WEBHOOK_DROP_PENDING_UPDATES=false
TELEGRAM_WEBHOOK_MAX_CONNECTIONS=10
