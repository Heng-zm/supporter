# Only credentials, identifiers, and secrets belong in the environment.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=
# Existing deployments may instead use one of these aliases:
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_KEY=YOUR_SERVICE_ROLE_OR_SERVER_SECRET
# SUPABASE_SERVICE_ROLE_KEY is also accepted as an alias.
TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_CHAT_ID=123456789
TELEGRAM_ADMIN_USER_IDS=123456789
TELEGRAM_WEBHOOK_SECRET=GENERATE_A_DISTINCT_SECRET
APP_ENVIRONMENT=production

# Audio behavior is stored in source code at:
# app/audio_extension/source_settings.py
# No AUDIO_* environment variables are required.

# Backend CORS origins are also stored in source code at:
# app/audio_extension/source_settings.py
# No BACKEND_CORS_ORIGINS environment variable is required.
