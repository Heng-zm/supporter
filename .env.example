APP_NAME=Ozo Donation API
APP_ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api

# Comma-separated React origins. Do not include a trailing slash.
BACKEND_CORS_ORIGINS=http://localhost:3000,https://your-frontend.example.com
ALLOWED_HOSTS=*
TRUST_PROXY_HEADERS=true
REQUEST_TIMEOUT_SECONDS=8

# Server-only Supabase credentials
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_OR_SERVICE_ROLE_KEY
SUPPORTERS_ADMIN_KEY=replace-with-a-long-random-admin-key
MAX_SUPPORTERS=100

# Server-only Telegram credentials
TELEGRAM_BOT_TOKEN=123456789:replace_me
TELEGRAM_CHAT_ID=replace_me
VISIT_ALERT_ENABLED=true
VISIT_HASH_SALT=replace-with-a-long-random-secret
VISIT_ALERT_COOLDOWN_MINUTES=30
REQUIRE_VISIT_STORAGE=false
