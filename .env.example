# Minimal production environment
APP_ENVIRONMENT=production
BACKEND_CORS_ORIGINS=https://your-frontend.example.com
ALLOWED_HOSTS=your-backend.example.com

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVICE_ROLE_KEY

# Telegram alerts and /add command
TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_CHAT_ID=123456789
TELEGRAM_COMMANDS_ENABLED=true
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-secret-at-least-24-characters
TELEGRAM_ADMIN_USER_IDS=123456789
TELEGRAM_WEBHOOK_URL=https://your-backend.example.com/api/telegram/webhook
TELEGRAM_AUTO_CONFIGURE_WEBHOOK=true

# Encrypted visit reporting
VISIT_HASH_SALT=replace-with-a-different-random-secret-at-least-24-characters
VISIT_PRIVATE_KEY_B64=BASE64_ENCODED_RSA_PRIVATE_KEY_PEM
